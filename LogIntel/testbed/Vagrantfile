Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  
  # Static IP matched with the README architecture
  config.vm.network "private_network", ip: "192.168.56.20"

  # Forwarded ports for Prometheus and Incident Controller
  config.vm.network "forwarded_port", guest: 30090, host: 30090, auto_correct: true
  config.vm.network "forwarded_port", guest: 30099, host: 30099, auto_correct: true

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "3072"
    vb.cpus = 2
  end

  # Run the standard provisioning scripts in order
  config.vm.provision "shell", path: "provision/00-base.sh"
  config.vm.provision "shell", path: "provision/10-k3s.sh"
  config.vm.provision "shell", path: "provision/20-deploy.sh"

  # Setup Helm and deploy the logintel-agent as requested
  config.vm.provision "shell", inline: <<-SHELL
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    
    if ! command -v helm &> /dev/null; then
      echo "==> Installing Helm"
      curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
      chmod 700 get_helm.sh
      ./get_helm.sh
    fi

    echo "==> Deploying logintel-agent via Helm"
    helm upgrade --install logintel-agent \
      oci://ghcr.io/sayuru-priyanjana/logintel-agent \
      --version 0.1.7 \
      -n logintel \
      --create-namespace \
      --set namespace=logintel \
      --set central.url="http://192.168.56.1" \
      --set auth.clusterId="shopdemo" \
      --set auth.token="logintel_tok_4ab6894a8506db25c0106df44eb6a456"
  SHELL

  # Run verify script on every `vagrant up`
  config.vm.provision "shell", path: "provision/30-verify.sh", run: "always"
end
