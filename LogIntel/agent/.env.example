# Copy to .env, or let scripts/bootstrap-agent.sh generate it with detected values.
# From WSL, <WINDOWS_HOST> is your default gateway: ip route | awk '/default/{print $3}'

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_SSL=false
OPENSEARCH_LOG_INDEX=logintel-logs-*
OPENSEARCH_EVENT_INDEX=logintel-events-*
OPENSEARCH_INVESTIGATION_INDEX=logintel-investigations

# The testbed's Prometheus, reached through the VirtualBox NAT forward on the
# Windows host. http://192.168.56.20:30090 also works if WSL can route to the
# host-only subnet.
PROMETHEUS_URL=http://<WINDOWS_HOST>:30090
INCIDENT_CONTROLLER_URL=http://<WINDOWS_HOST>:30099

OLLAMA_BASE_URL=http://<WINDOWS_HOST>:11434
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_TIMEOUT=180

# Load-bearing. Ollama defaults this to 2048 and silently truncates longer
# prompts, discarding the head — the model then answers from the tail having seen
# almost none of the evidence. The agent raises rather than accepting that.
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42

LOG_LEVEL=INFO
PERSIST_INVESTIGATIONS=true

# --- Tuning (defaults shown; see GET /api/config for what is actually in force)
# ONSET_MAD_MULTIPLIER=4.0
# ONSET_MIN_ABSOLUTE=3
# How many times busier the period after a candidate onset must be than the
# period before it. Lower it and ordinary variance in a service that always
# emits a few errors a minute gets promoted to "an incident"; every downstream
# signal is then measured against a baseline window picked by noise.
# ONSET_MIN_ELEVATION=2.5
# MIN_BASELINE_MINUTES=10
# ERROR_RATE_SPIKE_MULTIPLIER=3.0
# LATENCY_DEGRADATION_MULTIPLIER=2.0
# HTTP_5XX_RATIO_THRESHOLD=0.10
# CPU_SATURATION_RATIO=0.85
# CPU_THROTTLE_RATIO=0.20
# MEMORY_PRESSURE_RATIO=0.85
# TRAFFIC_SURGE_MULTIPLIER=2.5
