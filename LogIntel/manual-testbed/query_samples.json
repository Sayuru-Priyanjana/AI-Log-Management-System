{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "range": { "@timestamp": { "gte": "now-20m" } } },
        { "bool": { "should": [ { "term": { "log.level": "ERROR" } }, { "range": { "http.status_code": { "gte": 500 } } } ] } }
      ]
    }
  },
  "aggs": {
    "by_service": {
      "terms": { "field": "service.name" },
      "aggs": {
        "sample_errors": {
          "top_hits": {
            "size": 2,
            "_source": {
              "includes": [ "@timestamp", "service.name", "log.message", "http.status_code", "error.message", "error.type" ]
            }
          }
        }
      }
    }
  }
}
