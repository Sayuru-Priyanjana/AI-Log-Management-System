{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "range": { "@timestamp": { "gte": "now-15m" } } },
        { "bool": { "should": [ { "term": { "log.level": "ERROR" } }, { "range": { "http.status_code": { "gte": 500 } } } ] } }
      ]
    }
  },
  "aggs": {
    "by_service": {
      "terms": { "field": "service.name" },
      "aggs": {
        "over_time": {
          "date_histogram": {
            "field": "@timestamp",
            "fixed_interval": "1m",
            "min_doc_count": 1
          }
        }
      }
    }
  }
}
