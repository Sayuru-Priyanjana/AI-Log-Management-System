{
  "size": 0,
  "query": {
    "range": {
      "@timestamp": {
        "gte": "now-20m"
      }
    }
  },
  "aggs": {
    "by_service": {
      "terms": {"field": "service.name"},
      "aggs": {
        "errors": {
          "filter": {
            "bool": {
              "should": [
                { "term": { "log.level": "ERROR" } },
                { "range": { "http.status_code": { "gte": 500 } } }
              ]
            }
          }
        },
        "total_requests": {
          "value_count": { "field": "_id" }
        }
      }
    }
  }
}
